# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Local Docker:
# DATABASE_URL=postgresql://thepurple_user:thepurple_secret_password@localhost:5432/thepurple_db
#
# Supabase: do NOT use Direct (db.<ref>.supabase.co:5432) from a laptop — it is IPv6-only and very slow.
# Use Session pooler from Dashboard → Project Settings → Database → Connect:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://thepurple_user:thepurple_secret_password@localhost:5432/thepurple_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thepurple_db
DB_USER=thepurple_user
DB_PASSWORD=thepurple_secret_password
DB_DIALECT=postgres
DB_LOGGING=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=thepurple_master_key_123456789
MEILISEARCH_INDEX_PREFIX=thepurple

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=placeholder
CLOUDFLARE_R2_ACCESS_KEY_ID=placeholder
CLOUDFLARE_R2_SECRET_ACCESS_KEY=placeholder
CLOUDFLARE_R2_BUCKET=thepurple-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.thepurple.in

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder

# Shiprocket
SHIPROCKET_API_KEY=placeholder
SHIPROCKET_API_SECRET=placeholder
