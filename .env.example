# ==========================================
# ThePurple — Master Environment Blueprint
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://thepurple_user:thepurple_secret_password@localhost:5432/thepurple_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thepurple_db
DB_USER=thepurple_user
DB_PASSWORD=thepurple_secret_password
DB_DIALECT=postgres
DB_LOGGING=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Meilisearch Configuration
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=thepurple_master_key_123456789
MEILISEARCH_PORT=7700

# Cloudflare R2 (Product & Category Media)
CLOUDFLARE_R2_ACCOUNT_ID=placeholder_r2_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=placeholder_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
CLOUDFLARE_R2_BUCKET=thepurple-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.thepurple.in

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Shiprocket (Logistics & Shipment)
SHIPROCKET_API_KEY=placeholder_shiprocket_email
SHIPROCKET_API_SECRET=placeholder_shiprocket_password

# SMS / OTP Provider
SMS_OTP_API_KEY=placeholder_sms_api_key
SMS_OTP_SENDER_ID=THPURP
